# Makefile for batch training validation

CC = gcc
CFLAGS = -O3 -Wall -Wextra -march=native
LDFLAGS = -lOpenCL -lm -lcurl -lpthread

# Source files
SOURCES = batch_train_validate.c cnn_denoise.c
OBJECTS = $(SOURCES:.c=.o)
TARGET = batch_validate

# Simple test
TEST_SIMPLE = test_batch_simple
TEST_SIMPLE_SRC = test_batch_simple.c cnn_denoise.c

# Build validation executable
$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# Build simple test
$(TEST_SIMPLE): $(TEST_SIMPLE_SRC)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# Object files
%.o: %.c cnn_denoise.h
	$(CC) $(CFLAGS) -c $< -o $@

# Clean build artifacts
clean:
	rm -f $(OBJECTS) $(TARGET) $(TEST_SIMPLE)

# Run validation tests
test: $(TARGET)
	./$(TARGET)

# Run simple batch test
simple: $(TEST_SIMPLE)
	./$(TEST_SIMPLE)

# Run with profiling
profile: $(TARGET)
	CL_PROFILE_AMD=1 ./$(TARGET)

# Quick check compilation only
check:
	$(CC) $(CFLAGS) -fsyntax-only $(SOURCES)

.PHONY: clean test simple profile check

# Help target
help:
	@echo "Batch Training Validation Makefile"
	@echo ""
	@echo "Targets:"
	@echo "  make          - Build validation executable"
	@echo "  make simple   - Build and run simple batch test"
	@echo "  make test     - Build and run full tests"
	@echo "  make clean    - Remove build artifacts"
	@echo "  make check    - Check syntax without building"
	@echo "  make profile  - Run with OpenCL profiling enabled"
